# BEpusdt service
LISTEN=:8080
LOG=/var/log/bepusdt/
SQLITE=/var/lib/bepusdt/sqlite.db

# Comma-separated proxy IPs or CIDRs. Leave empty unless a trusted reverse proxy fronts BEpusdt.
BEPUSDT_TRUSTED_PROXIES=

# Exchange payment polling
BEPUSDT_EXCHANGE_POLL_INTERVAL=10s
BEPUSDT_EXCHANGE_TIMEOUT=8s

# Binance Pay (read-only API credentials)
BEPUSDT_BINANCE_API_KEY=
BEPUSDT_BINANCE_SECRET_KEY=
BEPUSDT_BINANCE_UID=
BEPUSDT_BINANCE_API_URL=https://api-gcp.binance.com

# OKX internal transfer (read-only API credentials)
BEPUSDT_OKX_API_KEY=
BEPUSDT_OKX_SECRET_KEY=
BEPUSDT_OKX_PASSPHRASE=
BEPUSDT_OKX_UID=
BEPUSDT_OKX_API_URL=https://www.okx.com
